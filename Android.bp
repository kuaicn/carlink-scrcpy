// scrcpy server 车机魔改版 —— 手机端投屏采集/编码/触控注入库
// 基于上游 Genymobile/scrcpy v4.1 (Apache-2.0)
// 以 android_library 编入 ROM，由互联服务 (privapp) 通过 static_libs 依赖，在其进程内运行。

android_library {
    name: "carlink_scrcpy",
    srcs: ["src/**/*.java"],
    // sdk_version 缺省 = 直编树内 platform（含 hidden API），与 WindowManager-Shell 同款
}
